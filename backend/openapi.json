            "in": "path",
            "name": "reader_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reader Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "confirm_history",
            "required": false,
            "schema": {
              "default": false,
              "title": "Confirm History",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
