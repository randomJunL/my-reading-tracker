        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Reader",
        "tags": [
          "readers"
        ]
      },
      "get": {
        "operationId": "get_reader_api_v1_readers__reader_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "reader_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Reader Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReaderResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Reader",
        "tags": [
          "readers"
        ]
      },
      "patch": {
        "operationId": "update_reader_api_v1_readers__reader_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "reader_id",
