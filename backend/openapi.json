    "/api/v1/book-search": {
      "get": {
        "operationId": "search_books_api_v1_book_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 2,
