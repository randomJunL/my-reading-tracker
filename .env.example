# Shared local configuration
APP_ENV=development
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH_EMAIL=developer@localhost
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Frontend configuration
VITE_APP_NAME=My Reading Tracker
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEV_AUTH_BYPASS=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local PostgreSQL configuration
POSTGRES_DB=my_reading_tracker
POSTGRES_USER=my_reading_tracker
POSTGRES_PASSWORD=my_reading_tracker_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://my_reading_tracker:my_reading_tracker_local@localhost:5432/my_reading_tracker

# Supabase authentication configuration (added in Step 5)
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# External book providers (added in Step 7)
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_CONTACT_EMAIL=
